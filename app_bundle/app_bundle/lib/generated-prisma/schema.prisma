generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated-prisma"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String
  role                  String                 @default("USER") // USER, ADMIN, MODERATOR
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  profiles              Profile[]
  sessions              Session[]
  disclaimerAcceptances DisclaimerAcceptance[]
  ratings               Rating[]
  reviews               Review[]
  adminLogs             AdminLog[]
}

model Profile {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  avatar        String?
  isKids        Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  watchlists    Watchlist[]
  watchHistory  WatchHistory[]
  watchProgress WatchProgress[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Movie {
  id                String   @id @default(uuid())
  tmdbId            Int?     @unique
  imdbId            String?  @unique
  title             String
  originalTitle     String?
  overview          String?
  releaseDate       String?
  runtime           Int?
  posterPath        String?
  backdropPath      String?
  voteAverage       Float    @default(0)
  voteCount         Int      @default(0)
  popularity        Float    @default(0)
  originalLanguage  String?
  originCountry     String?
  productionCountry String?
  isAnime           Boolean  @default(false)
  isCartoon         Boolean  @default(false)
  isAllowed         Boolean  @default(true) // Bangladesh exclusion filter check
  status            String   @default("METADATA_AVAILABLE_SOURCE_PENDING") // PUBLISHED, SOURCE_PENDING, HIDDEN, TAKEN_DOWN
  genres            String? // Comma separated or JSON string
  castSummary       String? // Top cast names
  director          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  externalContentIDs ExternalContentID[]
  videoSources       VideoSource[]
  audioTracks        AudioTrack[]
  subtitleTracks     SubtitleTrack[]
  watchHistory       WatchHistory[]
  watchProgress      WatchProgress[]
  watchlists         Watchlist[]
  ratings            Rating[]
  reviews            Review[]
  rightsRecords      RightsRecord[]
}

model Series {
  id                String   @id @default(uuid())
  tmdbId            Int?     @unique
  imdbId            String?  @unique
  title             String
  originalTitle     String?
  overview          String?
  firstAirDate      String?
  lastAirDate       String?
  posterPath        String?
  backdropPath      String?
  voteAverage       Float    @default(0)
  voteCount         Int      @default(0)
  popularity        Float    @default(0)
  originalLanguage  String?
  originCountry     String?
  productionCountry String?
  isAnime           Boolean  @default(false)
  isCartoon         Boolean  @default(false)
  isWebSeries       Boolean  @default(false)
  isAllowed         Boolean  @default(true) // Bangladesh exclusion filter check
  status            String   @default("METADATA_AVAILABLE_SOURCE_PENDING")
  genres            String?
  castSummary       String?
  numberOfSeasons   Int      @default(1)
  numberOfEpisodes  Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seasons            Season[]
  externalContentIDs ExternalContentID[]
  watchHistory       WatchHistory[]
  watchProgress      WatchProgress[]
  watchlists         Watchlist[]
  ratings            Rating[]
  reviews            Review[]
  rightsRecords      RightsRecord[]
}

model Season {
  id           String   @id @default(uuid())
  seriesId     String
  series       Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  seasonNumber Int
  title        String?
  overview     String?
  posterPath   String?
  airDate      String?
  episodeCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  episodes Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id            String   @id @default(uuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  title         String
  overview      String?
  stillPath     String?
  airDate       String?
  runtime       Int?
  voteAverage   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  videoSources   VideoSource[]
  audioTracks    AudioTrack[]
  subtitleTracks SubtitleTrack[]
  watchHistory   WatchHistory[]
  watchProgress  WatchProgress[]

  @@unique([seasonId, episodeNumber])
}

model ExternalContentID {
  id         String   @id @default(uuid())
  provider   String // "MOVIEBOX", "IMDB", "TMDB"
  externalId String
  movieId    String?
  movie      Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId   String?
  series     Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  detailPath String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, externalId])
}

model VideoSource {
  id           String    @id @default(uuid())
  movieId      String?
  movie        Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId    String?
  episode      Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  provider     String    @default("MOVIEBOX")
  format       String    @default("MP4") // MP4, DASH, HLS
  quality      String    @default("1080p")
  qualityValue Int       @default(1080)
  url          String
  signCookie   String?
  sizeMb       Float?
  codec        String?
  isAuthorized Boolean   @default(true)
  isHealthy    Boolean   @default(true)
  failureCount Int       @default(0)
  lastChecked  DateTime?
  latencyMs    Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AudioTrack {
  id        String   @id @default(uuid())
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  language  String // "English", "Hindi", "Japanese", "Original"
  langCode  String? // "en", "hi", "ja"
  label     String // "English [Original]", "Hindi Dubbed"
  isDefault Boolean  @default(false)
  isDubbed  Boolean  @default(false)
  url       String?
  createdAt DateTime @default(now())
}

model SubtitleTrack {
  id        String   @id @default(uuid())
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  language  String // "English", "Bengali", "Spanish"
  langCode  String // "en", "bn", "es"
  label     String
  format    String   @default("VTT") // VTT, SRT
  url       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Watchlist {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([profileId, movieId, seriesId])
}

model WatchHistory {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  completed Boolean  @default(false)
}

model WatchProgress {
  id            String   @id @default(uuid())
  profileId     String
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId       String?
  movie         Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId      String?
  series        Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodeId     String?
  episode       Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  seasonNumber  Int?
  episodeNumber Int?
  currentTime   Float    @default(0) // seconds
  duration      Float    @default(0) // seconds
  percentage    Float    @default(0) // 0 - 100
  updatedAt     DateTime @updatedAt

  @@unique([profileId, movieId, episodeId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  score     Int // 1 to 10
  createdAt DateTime @default(now())

  @@unique([userId, movieId, seriesId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model DisclaimerAcceptance {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  ipAddress  String?
  acceptedAt DateTime @default(now())
}

model RightsRecord {
  id                  String    @id @default(uuid())
  movieId             String?
  movie               Movie?    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId            String?
  series              Series?   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  rightsOwner         String?
  authorizationStatus String    @default("AUTHORIZED") // AUTHORIZED, EXPIRED, DISPUTED, REVOKED
  licenseStart        DateTime?
  licenseExpiry       DateTime?
  allowedTerritories  String? // "GLOBAL", "US,CA,IN"
  notes               String?
  createdAt           DateTime  @default(now())
}

model TakedownRequest {
  id           String   @id @default(uuid())
  claimantName String
  email        String
  contentTitle String
  tmdbId       Int?
  reason       String
  evidenceUrl  String?
  status       String   @default("PENDING") // PENDING, INVESTIGATING, TAKEN_DOWN, REJECTED
  actionNotes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SyncJob {
  id            String    @id @default(uuid())
  jobType       String // "TMDB_POPULAR", "TMDB_CHANGES", "MOVIEBOX_SYNC"
  status        String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  itemsImported Int       @default(0)
  itemsUpdated  Int       @default(0)
  itemsSkipped  Int       @default(0) // e.g. Bangladesh excluded
  errorMessage  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}

model AdminLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model SystemSettings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
