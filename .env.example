# PARXSTREAM Environment Variables Example
# Copy this file to .env and fill in your actual credentials.

# TMDB (The Movie Database) API Configuration
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# MovieBox Python Backend Upstream
MOVIEBOX_BACKEND_URL=http://localhost:8000
MOVIEBOX_FALLBACK_ACTIVE=true

# Optional: Cloudflare Worker Edge Relay Gateway
MOVIEBOX_GATEWAY_URL=
MOVIEBOX_GATEWAY_TOKEN=

# Database Configuration (SQLite default)
DATABASE_URL="file:./dev.db"

# Authentication & Security
AUTH_SECRET=generate_a_long_random_secret_key_here
ADMIN_KEY=your_admin_secret_key_here

# Application Configuration
NEXT_PUBLIC_APP_NAME="PARXSTREAM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DISCLAIMER_VERSION=1.0
NODE_ENV=production
